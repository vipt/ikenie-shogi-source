{
  "name": "meguru-shogi",
  "version": "1.2.27",
  "private": true,
  "packageManager": "npm@10.9.9",
  "main": "index.ts",
  "scripts": {
    "selfplay": "tsx scripts/self-play.ts",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile production",
    "selfplay:strong": "tsx scripts/self-play-strong.ts",
    "compare:cpu": "tsx scripts/compare-cpu.ts",
    "engine:install": "pwsh -NoProfile -File scripts/Install-UsiEngine.ps1",
    "engine:smoke": "tsx scripts/usi-standard.ts --mode smoke",
    "engine:selfplay": "tsx scripts/usi-standard.ts --mode selfplay",
    "engine:recovery:build": "pwsh -NoProfile -File scripts/Build-RecoveryEngine.ps1",
    "engine:recovery:validate": "tsx scripts/validate-recovery-engine.ts",
    "training:generate": "tsx scripts/generate-recovery-training.ts",
    "training:fit": ".tools/training-venv/Scripts/python.exe scripts/train-recovery-nnue.py",
    "training:compare": "tsx scripts/compare-recovery-training.ts",
    "book:build": "tsx scripts/build-recovery-book-v2.ts",
    "engine:trained": "tsx scripts/use-trained-recovery.ts",
    "engine:trained:validate": "tsx scripts/validate-recovery-profile.ts",
    "book:build:v1": "tsx scripts/build-recovery-book.ts",
    "book:research": "tsx scripts/research-recovery-openings.ts",
    "book:validate": "tsx scripts/validate-recovery-book-v2.ts",
    "book:mobile": "node scripts/update-mobile-book.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-audio": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eas-cli": "^27.10.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "license": "GPL-3.0-or-later"
}
